.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.date {
  font-size: 34rpx;
  font-weight: 700;
}

.mode {
  font-size: 24rpx;
  color: var(--ink-3);
}

.dish-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-body {
  margin-left: 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.dish-sub {
  font-size: 24rpx;
  color: var(--ink-3);
}

.total {
  margin-top: 20rpx;
  text-align: right;
  color: var(--pumpkin-deep);
  font-size: 28rpx;
  font-weight: 600;
}

.section-title {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #bbb;
}

.shop-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 30rpx;
}

.shop-item:last-child {
  border-bottom: none;
}

.shop-item.done .shop-name {
  text-decoration: line-through;
  color: #bbb;
}

.shop-item.done .shop-amount {
  color: #ddd;
}

.check {
  font-size: 36rpx;
  color: var(--leaf);
}

.shop-name {
  flex: 1;
}

.shop-amount {
  color: var(--ink-3);
  font-size: 26rpx;
}
