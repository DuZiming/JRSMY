/* ============ 全局设计 tokens · Organic 暖调家常厨房 ============ */
/* 色板：奶油底 / 墨 / 叶绿主 / 南瓜橘 CTA / 浅叶 / 暖沙 / 警示 */
page {
  --bg: #FAF6EF;
  --ink: #2F2A24;
  --ink-2: #6B6357;
  --ink-3: #9A9184;
  --leaf: #3E7B4F;
  --leaf-deep: #2F6340;
  --leaf-tint: #E9F2E6;
  --pumpkin: #E07A3A;
  --pumpkin-deep: #C96528;
  --pumpkin-tint: #FBEEE2;
  --sand: #F3EBDD;
  --card: #FFFFFF;
  --line: #EFE8DB;
  --danger: #C64B3C;
  --danger-tint: #FAECEA;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.55;
}

/* 通用分组卡 */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(47, 42, 36, 0.04);
}

/* 分组标题：小标签字距 */
.sec-label {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

/* 主/次按钮 */
.btn-primary {
  background: var(--leaf);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }

.btn-cta {
  background: var(--pumpkin);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 700;
}
.btn-cta::after { border: none; }

.btn-ghost {
  background: var(--card);
  color: var(--leaf);
  border: 2rpx solid var(--leaf);
  border-radius: 999rpx;
  font-weight: 600;
}
.btn-ghost::after { border: none; }

/* 描边图标（SVG data-URI，替代 emoji） */
.icon {
  display: inline-block;
  width: 34rpx;
  height: 34rpx;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  vertical-align: -6rpx;
