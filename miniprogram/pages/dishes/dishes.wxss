.filters {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0;
}

.chip {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 24rpx;
}

.chip.on {
  background: var(--leaf);
  color: #fff;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
}

.count {
  color: var(--ink-3);
  font-size: 26rpx;
}

.switch {
  color: var(--leaf);
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
  color: var(--ink-3);
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-btn {
  margin-top: 16rpx;
  background: var(--leaf);
  font-size: 28rpx;
}

/* 卡片视图：严格一行两个（不与全局 .card 类同名，border-box 防撑宽） */
.cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.dish-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(47, 42, 36, 0.05);
  transition: transform 0.12s ease;
}

.card-pressed {
  transform: scale(0.97);
}

.dish-card-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.dish-card-body {
  padding: 14rpx 18rpx 18rpx;
}

.dish-card-name {
  font-size: 29rpx;
  font-weight: 700;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dish-card-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dish-card-kcal {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--pumpkin-deep);
  font-weight: 600;
}

.dish-card-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.mini-tag {
  font-size: 22rpx;
  color: var(--leaf-deep);
  background: var(--leaf-tint);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.mini-tag.src {
  color: var(--ink-2);
  background: var(--bg);
}

.mini-tag.spicy {
  color: var(--danger);
  background: var(--danger-tint);
}

/* 列表视图：左图右文，电商式信息层级 */
.list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(47, 42, 36, 0.04);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.list-item:last-child {
  border-bottom: none;
}

.item-pressed {
  background: var(--bg);
}

.list-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.list-body {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.list-name {
  font-size: 31rpx;
  font-weight: 700;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-badges {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}

.list-meta {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--leaf);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(82, 165, 101, 0.4);
}

.icon-plus-fab {
  width: 44rpx;
  height: 44rpx;
}

.tabbar-gap {
  height: 180rpx;
}
