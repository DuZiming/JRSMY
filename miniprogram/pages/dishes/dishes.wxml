<view class="page">
  <!-- 筛选器 -->
  <view class="filters">
    <view class="filter-group">
      <view
        wx:for="{{sourceFilters}}"
        wx:key="key"
        class="chip {{filterSource === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setSource"
      >{{item.label}}</view>
    </view>
    <view class="filter-group">
      <view
        wx:for="{{typeFilters}}"
        wx:key="key"
        class="chip {{filterType === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setType"
      >{{item.label}}</view>
    </view>
    <view class="filter-group">
      <view
        wx:for="{{tagFilters}}"
        wx:key="key"
        class="chip {{filterTag === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setTag"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 视图切换 -->
  <view class="toolbar">
    <text class="count">{{dishes.length}} 道菜</text>
    <view class="switch" bindtap="switchView">{{viewMode === 'card' ? '☰ 列表' : '▦ 卡片'}}</view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{!loading && !dishes.length}}" class="empty">
    <text class="empty-icon">🍽️</text>
    <text>厨房还是空的，先加一道菜吧</text>
    <button class="empty-btn" type="primary" bindtap="addDish">＋ 添加菜品</button>
  </view>

  <!-- 卡片视图 -->
  <view wx:if="{{viewMode === 'card'}}" class="cards">
    <view
      wx:for="{{dishes}}"
      wx:key="_id"
      class="card"
      data-id="{{item._id}}"
      bindtap="openDetail"
    >
      <image class="card-img" src="{{item.photos[0]}}" mode="aspectFill" />
      <view class="card-body">
        <text class="card-name">{{item.name}}</text>
        <view class="card-tags">
          <text class="mini-tag">{{item.type === 'meat' ? '荤' : item.type === 'veg' ? '素' : item.type === 'staple' ? '主食' : item.type === 'soup' ? '汤' : '饮'}}</text>
          <text wx:if="{{item.spicy_level > 0}}" class="mini-tag spicy">辣{{item.spicy_level}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表视图 -->
  <view wx:else class="list">
    <view
      wx:for="{{dishes}}"
      wx:key="_id"
      class="list-item"
      data-id="{{item._id}}"
      bindtap="openDetail"
    >
      <image class="list-img" src="{{item.photos[0]}}" mode="aspectFill" />
      <view class="list-body">
        <text class="list-name">{{item.name}}</text>
        <text class="list-sub">{{item.tags.length ? item.tags.join(' · ') : '没有标签'}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="fab" bindtap="addDish">＋</view>
</view>
