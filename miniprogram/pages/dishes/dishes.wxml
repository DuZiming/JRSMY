<view class="page">
  <!-- 筛选器 -->
  <view class="filters">
    <view class="filter-group">
      <view
        wx:for="{{sourceFilters}}"
        wx:key="key"
        class="chip {{filterSource === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setSource"
      >{{item.label}}</view>
    </view>
    <view class="filter-group">
      <view
        wx:for="{{typeFilters}}"
        wx:key="key"
        class="chip {{filterType === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setType"
      >{{item.label}}</view>
    </view>
    <view class="filter-group">
      <view
        wx:for="{{tagFilters}}"
        wx:key="key"
        class="chip {{filterTag === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="setTag"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 视图切换 -->
  <view class="toolbar">
    <text class="count">{{dishes.length}} 道菜</text>
    <view class="switch" bindtap="switchView">{{viewMode === 'card' ? '☰ 列表' : '▦ 卡片'}}</view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{!loading && !dishes.length}}" class="empty">
    <text class="empty-icon">🍽️</text>
    <text>厨房还是空的，先加一道菜吧</text>
    <button class="empty-btn" type="primary" bindtap="addDish">＋ 添加菜品</button>
  </view>

  <!-- 卡片视图：一行两个（电商双列） -->
  <view wx:if="{{viewMode === 'card'}}" class="cards">
    <view
      wx:for="{{dishes}}"
      wx:key="_id"
      class="dish-card"
      hover-class="card-pressed"
      data-id="{{item._id}}"
      bindtap="openDetail"
    >
      <image class="dish-card-img" src="{{item.photos[0]}}" mode="aspectFill" />
      <view class="dish-card-body">
        <text class="dish-card-name">{{item.name}}</text>
        <view class="dish-card-row">
          <text class="mini-tag">{{typeLabels[item.type]}}</text>
          <text wx:if="{{item.spicy_level > 0}}" class="mini-tag spicy">辣{{item.spicy_level}}</text>
          <text wx:if="{{item.calories}}" class="dish-card-kcal">{{item.calories}}kcal</text>
        </view>
        <text wx:if="{{item.tags.length}}" class="dish-card-sub">{{item.tags[0]}}</text>
      </view>
    </view>
  </view>

  <!-- 列表视图：左图右文（电商列表） -->
  <view wx:else class="list">
    <view
      wx:for="{{dishes}}"
      wx:key="_id"
      class="list-item"
      hover-class="item-pressed"
      data-id="{{item._id}}"
      bindtap="openDetail"
    >
      <image class="list-img" src="{{item.photos[0]}}" mode="aspectFill" />
      <view class="list-body">
        <text class="list-name">{{item.name}}</text>
        <view class="list-badges">
          <text class="mini-tag">{{typeLabels[item.type]}}</text>
          <text class="mini-tag src">{{sourceLabels[item.source]}}</text>
          <text wx:if="{{item.spicy_level > 0}}" class="mini-tag spicy">辣{{item.spicy_level}}</text>
        </view>
        <view class="list-meta">
          <text wx:if="{{item.tags.length}}">{{item.tags[0]}}</text>
          <text wx:if="{{item.calories}}">{{item.calories}} kcal</text>
        </view>
      </view>
      <text class="icon icon-chevron" />
    </view>
  </view>

  <view class="fab" bindtap="addDish">
    <text class="icon icon-plus" />
  </view>
  <view class="tabbar-gap" />
</view>
