.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.photo-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.55);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
  border-radius: 0 0 16rpx 16rpx;
}

.rotate-canvas {
  position: fixed;
  left: -3000px;
  top: 0;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #bbb;
}

.ai-btn {
  margin-top: 20rpx;
  background: var(--leaf);
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.ai-btn.loading {
  background: #9ec3a6;
}

.ai-tip {
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 170rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  font-size: 28rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ddd;
  color: var(--ink-2);
  font-size: 26rpx;
}

.tag.on {
  background: var(--leaf-tint);
  border-color: var(--leaf);
  color: var(--leaf-deep);
}

.tag-input {
  margin-top: 16rpx;
  background: var(--bg);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.ing-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ing-name {
  flex: 1.2;
}

.ing-amount {
  flex: 1;
  background: var(--bg);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
}

.ing-del {
  width: 48rpx;
  text-align: center;
  color: #c00;
  font-size: 36rpx;
}

.link {
  color: var(--leaf);
  font-size: 28rpx;
  padding: 8rpx 0;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
}

.save-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--leaf);
}

.bottom-gap {
  height: 140rpx;
}
