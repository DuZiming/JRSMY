.filters {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0;
}

.chip {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 24rpx;
}

.chip.on {
  background: var(--leaf);
  color: #fff;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 8rpx;
}

.count {
  color: var(--ink-3);
  font-size: 26rpx;
}

.switch {
  color: var(--leaf);
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
  color: var(--ink-3);
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-btn {
  margin-top: 16rpx;
  background: var(--leaf);
  font-size: 28rpx;
}

.cards {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.card {
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 240rpx;
}

.card-body {
  padding: 16rpx 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
}

.card-tags {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
}

.mini-tag {
  font-size: 22rpx;
  color: var(--leaf-deep);
  background: var(--leaf-tint);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.mini-tag.spicy {
  color: var(--danger);
  background: var(--danger-tint);
}

.list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.list-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.list-body {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.list-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.list-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.arrow {
  color: #ccc;
  font-size: 40rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--leaf);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(82, 165, 101, 0.4);
}

.icon-plus-fab {
  width: 44rpx;
  height: 44rpx;
}

.tabbar-gap {
  height: 180rpx;
}
