/* 悬浮胶囊 tabBar */
.tab-bar {
  display: flex;
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  right: 32rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx;
  box-shadow: 0 10rpx 40rpx rgba(47, 42, 36, 0.14);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 999rpx;
}

.tab-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #9A9184;
}

.active {
  background: #E9F2E6;
}

.active .tab-text {
  color: #2F6340;
  font-weight: 700;
}
